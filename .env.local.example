# Android PCD Bengal Max — Secrets Template
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Fill in real values in .env.local (NEVER commit it)
# 3. .env.local is in .gitignore — kept local only
# 4. Load before deploying: source .env.local

# ====== Device Connection ======
DEVICE_SERIAL=
DEVICE_IP=
DEVICE_PORT=5555

# ====== Firebase / Backend ======
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_DATABASE_URL=

# ====== Claude / Anthropic API ======
ANTHROPIC_API_KEY=

# ====== Database Credentials ======
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# ====== WiFi Debugging (Optional) ======
ADB_WIFI_HOST=
ADB_WIFI_PORT=5555

# ====== Test Accounts ======
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_DEVICE_ID=

# ====== Build Configuration ======
BUILD_VARIANT=debug
BUILD_KEYSTORE_PATH=
BUILD_KEYSTORE_PASSWORD=
BUILD_KEY_ALIAS=
BUILD_KEY_PASSWORD=

# ====== App-Specific Config ======
APP_NAME=Jules
APP_PACKAGE_NAME=com.friendly.writers
APP_VERSION=1.0.0
