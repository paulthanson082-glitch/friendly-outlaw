<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. Compose handles the full UI; this is used only for
         the system chrome (status bar, navigation bar) before Compose takes over. -->
    <style name="Theme.DevTools" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
