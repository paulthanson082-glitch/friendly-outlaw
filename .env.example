# WritersApp Development Environment Configuration
# Copy this file to .env and fill in your actual values
# Do NOT commit .env to git (it's in .gitignore)

# ============================================================================
# ANTHROPIC API - AI Writing Features
# ============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-

# ============================================================================
# DATABASE
# ============================================================================
# Path to SQLite database (leave empty for default ~/Documents/writersapp.db)
DATABASE_PATH=

# ============================================================================
# AI MODEL CONFIGURATION
# ============================================================================
# Options: claude-3-5-sonnet, claude-3-opus, claude-3-sonnet, claude-3-haiku
AI_MODEL=claude-3-5-sonnet

# Maximum tokens for AI responses
AI_MAX_TOKENS=4096

# Temperature (0.0 = deterministic, 1.0 = creative)
AI_TEMPERATURE=0.7

# ============================================================================
# RAGIE INTEGRATION (Optional - for document understanding)
# ============================================================================
RAGIE_API_KEY=
RAGIE_WORKSPACE_ID=

# ============================================================================
# DEVELOPMENT OPTIONS
# ============================================================================
# Enable verbose logging
DEBUG=false

# Enable test mode (uses in-memory database)
TEST_MODE=false

# ============================================================================
# AIMS PLATFORM (Web App)
# ============================================================================
# Next.js and backend configuration
NODE_ENV=development
PORT=3000
DATABASE_URL=

# ============================================================================
# BUILD OPTIONS
# ============================================================================
# Build configuration (debug or release)
BUILD_CONFIG=debug

# Enable Metal GPU rendering (macOS only)
METAL_RENDERING=true
