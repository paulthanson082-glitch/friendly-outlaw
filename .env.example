# SEO Machine — Environment Variables
# Copy this file to .env and fill in your values
# .env is git-ignored and should never be committed

# ============================================================
# Google Analytics 4
# ============================================================
GA4_PROPERTY_ID=123456789
GA4_CREDENTIALS_PATH=data_sources/config/ga4_credentials.json

# ============================================================
# Google Search Console
# ============================================================
GSC_SITE_URL=https://yoursite.com
# GSC uses the same credentials file as GA4

# ============================================================
# DataForSEO
# ============================================================
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# ============================================================
# WordPress REST API
# ============================================================
WP_URL=https://yoursite.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Generate app password: WordPress Admin → Users → Profile → Application Passwords

# ============================================================
# Anthropic API (for AI features)
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
