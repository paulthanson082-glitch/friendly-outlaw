# Writers App Backend Configuration
# Copy this to .env and fill in your actual values
# NOTE: All settings have safe defaults for local development — a .env file is
# only required if you want to override those defaults or enable AI features.

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_USE_SQLITE=true
SQLITE_PATH=./data/writers_app.db
# For PostgreSQL instead:
# DATABASE_USE_SQLITE=false
# DATABASE_URL=postgresql://user:password@localhost:5432/writers_app

# MongoDB / Mongoose (optional — server starts without it)
# When set, Mongoose connects automatically on startup.
# MONGODB_URI=mongodb://localhost:27017/writers_app

# JWT Authentication
# Must be at least 32 characters.
# A default development value is used when this is not set, so the server
# will start without a .env file in development mode.
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-characters-long-replace-me
JWT_EXPIRES_IN=7d

# AI / Claude API
# Optional — the server starts and runs without this key.
# AI chat endpoints will return an error until a valid key is provided.
# Get your API key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxx-your-actual-api-key

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug
