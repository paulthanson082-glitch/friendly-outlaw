# Writers App Backend Configuration
# Copy this to .env and fill in your actual values

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_USE_SQLITE=true
SQLITE_PATH=./data/writers_app.db
# For PostgreSQL instead:
# DATABASE_USE_SQLITE=false
# DATABASE_URL=postgresql://user:password@localhost:5432/writers_app

# JWT Authentication
# Must be at least 32 characters
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-characters-long-replace-me
JWT_EXPIRES_IN=7d

# AI / Claude API
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx-your-actual-api-key

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug
