{
  "name": "friendly-outlaw",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:frontend": "turbo run dev --filter=writers-app-web",
    "dev:backend": "turbo run dev --filter=writers-app-api",
    "dev:mobile": "turbo run dev --filter=jules-mobile",
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter=writers-app-web",
    "build:backend": "turbo run build --filter=writers-app-api",
    "build:mobile": "turbo run build --filter=jules-mobile",
    "start": "turbo run start --filter=writers-app-api",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "type-check": "turbo run type-check",
    "db:migrate": "turbo run db:migrate --filter=writers-app-api",
    "db:seed": "turbo run db:seed --filter=writers-app-api",
    "clean": "turbo run clean --parallel && rm -rf node_modules .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^17.3.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "turbo": "^2.3.0",
    "typescript": "^5"
  }
}